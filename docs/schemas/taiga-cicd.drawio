<mxfile host="app.diagrams.net" type="device"><diagram id="cicd" name="CI/CD"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;CI/CD de Taiga : du commit à la production&lt;/b&gt; · 3 dépôts, 3 pipelines, 1 promotion par empreinte" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#1F2933;fontSize=22;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1900" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Schéma CI/CD · état au 04/11/2026 · d'après les .gitlab-ci.yml des dépôts back, front et infra" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#1F2933;fontColor=#4A5568;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="1900" height="24" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Développeur&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;commit sur sa branche de travail&lt;br&gt;puis merge request relue vers staging&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fontColor=#1F2933;fillColor=#DCE9F8;strokeColor=#1F6FD1;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="180" height="90" as="geometry"/></mxCell><mxCell id="c4" value="Dépôt taiga-backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FE;strokeColor=#1F6FD1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#1F6FD1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="230" y="90" width="1000" height="170" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;test · tests-rapides&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;toutes les branches&lt;br&gt;check · migrate sur PostgreSQL 17 · pytest unitaires&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fon