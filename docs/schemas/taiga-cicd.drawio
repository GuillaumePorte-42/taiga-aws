F2F2F2;strokeColor=#6B7785;" vertex="1" parent="1"><mxGeometry x="250" y="402" width="250" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;qualite · sonarcloud&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;staging, si app/ change&lt;br&gt;bloquante pendant le développement&lt;br&gt;(informative à terme)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fontColor=#1F2933;fillColor=#FFF0DB;strokeColor=#C77A00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="530" y="350" width="250" height="100" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;build · construire-image&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;étiquette &amp;lt;branche&amp;gt;-&amp;lt;sha&amp;gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fontColor=#1F2933;fillColor=#F2F2F2;strokeColor=#6B7785;" vertex="1" parent="1"><mxGeometry x="810" y="350" width="250" height="100" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Registre GitLab&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;taiga-backend et taiga-frontend&lt;br&gt;une image par commit, désignée&lt;br&gt;par son empreinte sha256&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fontColor=#1F2933;fillColor=#EDE3F5;strokeColor=#8E5BB5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1270" y="235" width="220" height="110" as="geometry"/></mxCell><mxCell id="c14" value="Dépôt taiga-infrastructure · branche staging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBF3;strokeColor=#C77A00;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#C77A00;arcSize=2;" vertex="1" parent="1"><mxGeometry x="230" y="520" width="1700" height="210" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;validate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;gitleaks · trivy (HIGH, CRITICAL)&lt;br&gt;terraform fmt, validate, tflint (si terraform/ change)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fontColor=#1F2933;fillColor=#F2F2F2;strokeColor=#6B7785;" vertex="1" parent="1"><mxGeometry x="250" y="560" width="260" height="95" as="geometry"/></mxCell><mxCell id="c16" value="&lt;font style='font-size:11px'&gt;yamllint et ansible-lint&lt;br&gt;&lt;b&gt;désactivés&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fontColor=#1F2933;fillColor=#FFFFFF;strokeColor=#B0B8C4;dashed=1;fontColor=#8A94A3;" vertex="1" parent="1"><mxGeometry x="250" y="665" width="260" height="45" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Référence d'image&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;empreinte de la nouvelle image&lt;br&gt;dans les group_vars du staging&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fontColor=#1F2933;fillColor=#DCE9F8;strokeColor=#1F6FD1;" vertex="1" parent="1"><mxGeometry x="560" y="560" width="220" height="95" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;deploy · deployer-staging&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;si le staging change · Ansible&lt;br&gt;Docker Compose + verifier_taiga&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fontColor=#1F2933;fillColor=#FFF0DB;strokeColor=#C77A00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="830" y="560" width="250" height="95" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;test · tests-e2e&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Playwright : un utilisateur&lt;br&gt;se connecte (compte e2e-test)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fontColor=#1F2933;fillColor=#FFF0DB;strokeColor=#C77A00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1130" y="560" width="240" height="95" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;test · tests-charge&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Locust, 20 utilisateurs, 1 min&lt;br&gt;auto si l'image change, sinon bouton&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fontColor=#1F2933;fillColor=#FFF0DB;strokeColor=#C77A00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1420" y="560" width="240" height="95" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Merge request&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;staging → production&lt;br&gt;relue par un autre membre&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fontColor=#1F2933;fillColor=#DCE9F8;strokeColor=#1F6FD1;" vertex="1" parent="1"><mxGeometry x="1710" y="560" width="200" height="95" as="geometry"/></mxCell><mxCell id="c22" value="Dépôt taiga-infrastructure · branche production" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4FBF6;strokeColor=#2E8B57;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#2E8B57;arcSize=2;" vertex="1" parent="1"><mxGeometry x="230" y="770" width="1700" height="200" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Référence d'image&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;la même empreinte qu'en staging,&lt;br&gt;dans group_vars/role_swarm_node.yml&lt;br&gt;(construire une fois, déployer partout)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fontColor=#1F2933;fillColor=#DCE9F8;strokeColor=#1F6FD1;" vertex="1" parent="1"><mxGeometry x="830" y="810" width="260" height="110" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;deploy · deployer-production ▶&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;bouton manuel · un seul à la fois (resource_group)&lt;br&gt;historique dans Operate → Environments&lt;br&gt;stack Swarm, mise à jour stop-first&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fontColor=#1F2933;fillColor=#E3F4E8;strokeColor=#2E8B57;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1140" y="810" width="320" height="110" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;verifier_taiga&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;HTTPS sur taiga-ledevagilles.fr&lt;br&gt;DNS, ALB, certificat, API&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fontColor=#1F2933;fillColor=#E3F4E8;strokeColor=#2E8B57;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1510" y="810" width="220" height="110" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Retour arrière&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;git revert de la référence d'image&lt;br&gt;→ même chaîne, même bouton&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E5484D;dashed=1;fontSize=12;fontColor=#C2262E;" vertex="1" parent="1"><mxGeometry x="1510" y="930" width="220" height="32" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Parameter Store&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;clé SSH de la CI (une pour staging et production),&lt;br&gt;mot de passe e2e, jeton SonarCloud&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fontColor=#1F2933;fillColor=#F2F2F2;strokeColor=#6B7785;" vertex="1" parent="1"><mxGeometry x="1560" y="110" width="250" height="80" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;SonarCloud&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fontColor=#1F2933;fillColor=#FFFFFF;strokeColor=#6B7785;" vertex="1" parent="1"><mxGeometry x="1560" y="215" width="250" height="45" as="geometry"/></mxCell><mxCell id="c29" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1F6FD1;strokeWidth=2;dashed=0;fontSize=11;fontColor=#1F6FD1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="180"/></Array></mxGeometry></mxCell><mxCell id="c30" value="push" 