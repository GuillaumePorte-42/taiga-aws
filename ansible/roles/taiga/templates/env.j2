# Généré par Ansible (rôle taiga) : ne pas modifier à la main. Contient des secrets : droits 0600.

# Images : les nôtres (étiquette donnée par l'environnement), puis les officielles en version fixe
TAIGA_IMAGE_BACK={{ taiga_image_back }}:{{ taiga_etiquette_back }}
TAIGA_IMAGE_FRONT={{ taiga_image_front }}:{{ taiga_etiquette_front }}
TAIGA_IMAGE_POSTGRES={{ taiga_image_postgres }}
TAIGA_IMAGE_RABBITMQ={{ taiga_image_rabbitmq }}
TAIGA_IMAGE_EVENTS={{ taiga_image_events }}
TAIGA_IMAGE_PROTECTED={{ taiga_image_protected }}
TAIGA_IMAGE_GATEWAY={{ taiga_image_gateway }}
TAIGA_IMAGE_MAILPIT={{ taiga_image_mailpit }}

# Adresse publique : HTTPS servi par l'ALB, websockets sécurisés (wss)
TAIGA_SCHEME=https
TAIGA_DOMAIN={{ taiga_domaine }}
SUBPATH=""
WEBSOCKETS_SCHEME=wss

# Clé secrète Django (signatures, jetons des pièces jointes), lue dans Parameter Store
SECRET_KEY='{{ taiga_secrets.secret_key }}'

# Base de données
POSTGRES_USER=taiga
POSTGRES_PASSWORD='{{ taiga_secrets.postgres_password }}'

# E-mails : réglages venus des variables du rôle (Mailpit par défaut sur le staging ; SES si on les remplace avec -e)
EMAIL_BACKEND={{ taiga_email_backend }}
EMAIL_HOST={{ taiga_email_hote }}
EMAIL_PORT={{ taiga_email_port }}
EMAIL_HOST_USER='{{ taiga_email_utilisateur }}'
EMAIL_HOST_PASSWORD='{{ taiga_email_mot_de_passe }}'
EMAIL_DEFAULT_FROM=no-reply@{{ taiga_domaine }}
EMAIL_USE_TLS={{ taiga_email_tls }}
EMAIL_USE_SSL=False

# RabbitMQ (les deux files utilisent le même compte)
RABBITMQ_USER=taiga
RABBITMQ_PASS='{{ taiga_secrets.rabbitmq_pass }}'
RABBITMQ_VHOST=taiga
RABBITMQ_ERLANG_COOKIE='{{ taiga_secrets.rabbitmq_erlang_cookie }}'

# Durée de vie du lien d'une pièce jointe (secondes), et pas de télémétrie vers l'éditeur
ATTACHMENTS_MAX_AGE=360
ENABLE_TELEMETRY=False

# Langue par défaut et fuseau des tâches de fond : mêmes valeurs que la production (back.env.j2)
LANGUAGE_CODE=fr
CELERY_TIMEZONE=Europe/Paris
