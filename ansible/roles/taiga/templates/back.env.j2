# Généré par Ansible (rôle taiga, stack) : ne pas modifier à la main. Secrets : droits 0600.
# Utilisé par taiga-back, taiga-async et le conteneur ponctuel des migrations.
POSTGRES_DB=taiga
POSTGRES_USER=taiga
POSTGRES_PASSWORD={{ taiga_secrets.postgres_password }}
POSTGRES_HOST={{ taiga_postgres_hote }}
POSTGRES_SSLMODE={{ taiga_postgres_sslmode }}
TAIGA_SECRET_KEY={{ taiga_secrets.secret_key }}
TAIGA_SITES_SCHEME=https
TAIGA_SITES_DOMAIN={{ taiga_domaine }}
TAIGA_SUBPATH=
# E-mails : réglages venus des variables du rôle (SES en production, voir playbooks/group_vars/role_swarm_node.yml)
EMAIL_BACKEND=django.core.mail.backends.{{ taiga_email_backend }}.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@{{ taiga_domaine }}
EMAIL_USE_TLS={{ taiga_email_tls }}
EMAIL_USE_SSL=False
EMAIL_HOST={{ taiga_email_hote }}
EMAIL_PORT={{ taiga_email_port }}
EMAIL_HOST_USER={{ taiga_email_utilisateur }}
EMAIL_HOST_PASSWORD={{ taiga_email_mot_de_passe }}
RABBITMQ_USER=taiga
RABBITMQ_PASS={{ taiga_secrets.rabbitmq_pass }}
ENABLE_TELEMETRY=False

LANGUAGE_CODE=fr
CELERY_TIMEZONE=Europe/Paris